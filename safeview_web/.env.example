# Database
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/safeview?schema=public"

# Clerk Authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Stripe Payment Processing
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudflare R2 Storage (S3-compatible)
# Get these from Cloudflare R2 dashboard
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="safeview-recordings"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# Sentry Error Tracking
# Get these from https://sentry.io
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="your-org"
SENTRY_PROJECT="safeview-web"
SENTRY_AUTH_TOKEN="your-auth-token"
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# WebRTC / Signaling Server
# Configure your signaling server URL for WebRTC connections
NEXT_PUBLIC_SIGNALING_SERVER_URL="wss://your-signaling-server.com"
SIGNALING_SERVER_SECRET="your-signaling-secret"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Session Configuration
# Default session duration in minutes (5-120)
DEFAULT_SESSION_DURATION_MINUTES="60"
MAX_SESSION_DURATION_MINUTES="120"
MIN_SESSION_DURATION_MINUTES="5"

# Security
# Add your allowed origins for CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Email (Optional - for notifications)
# If using services like SendGrid, Resend, etc.
EMAIL_FROM="noreply@safeview.app"
EMAIL_API_KEY="your-email-api-key"

# Redis (Optional - for session management and rate limiting)
REDIS_URL="redis://localhost:6379"

# Feature Flags (Optional)
ENABLE_SCREEN_RECORDING="true"
ENABLE_AUTO_REDACTION="true"
ENABLE_AUDIT_LOGS="true"
